<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Reaparr.Application</RootNamespace>
        <AssemblyName>Reaparr.Application</AssemblyName>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="CSharpier.MsBuild" Version="1.2.5">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="FastEndpoints" Version="7.1.1" />
        <PackageReference Include="FastEndpoints.Security" Version="7.1.1" />
        <PackageReference Include="FastEndpoints.Swagger" Version="7.1.1" />
        <PackageReference Include="Jason.Landbridge.Autofac.Extras.Quartz" Version="9.0.3" />
        <PackageReference Include="MessagePack" Version="3.1.4" />
        <PackageReference Include="Polly" Version="8.6.5" />
        <PackageReference Include="Polly.Core" Version="8.6.5" />
        <PackageReference Include="Quartz.Serialization.SystemTextJson" Version="3.15.1" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Application.Contracts\Application.Contracts.csproj" />
        <ProjectReference Include="..\BackgroundJobs.Contracts\BackgroundJobs.Contracts.csproj" />
        <ProjectReference Include="..\Data.Contracts\Data.Contracts.csproj" />
        <ProjectReference Include="..\Domain\Domain.csproj" />
        <Compile Include="..\Domain\GlobalUsings.cs" />
        <ProjectReference Include="..\FileSystem.Contracts\FileSystem.Contracts.csproj" />
        <ProjectReference Include="..\Identity.Contracts\Identity.Contracts.csproj" />
        <ProjectReference Include="..\PlexApi.Contracts\PlexApi.Contracts.csproj" />
        <ProjectReference Include="..\PublicAPI.Contracts\PublicAPI.Contracts.csproj" />
        <ProjectReference Include="..\Settings.Contracts\Settings.Contracts.csproj" />
        <ProjectReference Include="..\Settings\Settings.csproj" />
    </ItemGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Reaparr.Application.UnitTests" />
    </ItemGroup>
</Project>
