<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <ReaparrRuntimeMode Condition="'$(ReaparrRuntimeMode)' == ''">docker</ReaparrRuntimeMode>
        <ReaparrRuntimeIdentifier Condition="'$(ReaparrRuntimeIdentifier)' == '' and '$(RuntimeIdentifier)' != ''"
            >$(RuntimeIdentifier)</ReaparrRuntimeIdentifier
        >
        <ReaparrRuntimeIdentifier Condition="'$(ReaparrRuntimeIdentifier)' == ''">unknown</ReaparrRuntimeIdentifier>
        <CSharpier_Bypass>true</CSharpier_Bypass>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>ReaparrRuntimeMode</_Parameter1>
            <_Parameter2>$(ReaparrRuntimeMode)</_Parameter2>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>ReaparrRuntimeIdentifier</_Parameter1>
            <_Parameter2>$(ReaparrRuntimeIdentifier)</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>
</Project>
