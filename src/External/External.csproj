<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>Reaparr.External</AssemblyName>
        <RootNamespace>Reaparr.External</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <None
            Include="dash-mpd-cli\binary\**\*"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="Always"
        />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Autofac" Version="9.0.0" />
        <PackageReference Include="CliWrap" Version="3.10.0" />
        <PackageReference Include="System.IO.Abstractions" Version="22.1.0" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Application.Contracts\Application.Contracts.csproj" />
        <ProjectReference Include="..\External.Contracts\External.Contracts.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="..\Domain\GlobalUsings.cs">
            <Link>GlobalUsings.cs</Link>
        </Compile>
    </ItemGroup>
</Project>
