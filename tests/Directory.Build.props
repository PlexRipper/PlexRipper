<Project>
    <Import Project="../Directory.Build.props" Condition="Exists('../Directory.Build.props')" />
    <ItemGroup>
        <Using Include="TUnit.Assertions" />
        <Using Include="TUnit.Assertions.Extensions" />
        <Using Include="TUnit.Core" />
        <Using Include="TUnit.Core.HookType" Static="true" />
        <Using Include="Autofac.Extras.Moq" />
        <Using Include="Bogus" />
        <Using Include="JetBrains.Annotations" />
        <Using Include="Moq" />
        <Using Include="Reaparr.BaseTests" />
        <Using Include="Shouldly" />
    </ItemGroup>
    <ItemGroup Condition="'$(MSBuildProjectName)' != 'AppHost.UnitTests'">
        <Using Include="System.ComponentModel.DataAnnotations" />
        <Using Include="System.ComponentModel.DataAnnotations.Schema" />
        <Using Include="FastEndpoints" />
        <Using Include="FluentResults" />
        <Using Include="FluentValidation" />
        <Using Include="Microsoft.AspNetCore.Http" />
        <Using Include="Reaparr.Domain" />
        <Using Include="Reaparr.Logging" />
        <Using Include="Serilog" />
        <Using Include="Xunit" />
    </ItemGroup>
</Project>
